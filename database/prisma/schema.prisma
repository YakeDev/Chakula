generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  client
  restaurant
  livreur
  admin
  super_admin
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  assigned
  picked_up
  delivered
  cancelled
}

enum PaymentMethod {
  mpesa
  airtel
  cash
}

enum PaymentStatus {
  initiated
  confirmed
  failed
  refunded
}

enum DeliveryStatus {
  waiting
  assigned
  picked_up
  delivered
  cancelled
}

model User {
  id           String        @id @default(uuid())
  fullname     String
  email        String        @unique
  phone        String        @unique
  role         UserRole
  passwordHash String
  restaurants  Restaurant[]
  orders       Order[]
  deliveries   Delivery[]    @relation("DriverDeliveries")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Restaurant {
  id         String   @id @default(uuid())
  owner      User     @relation(fields: [ownerId], references: [id])
  ownerId    String
  name       String
  address    String
  lat        Float
  lng        Float
  avatarUrl  String?
  isOpen     Boolean  @default(true)
  menus      MenuItem[]
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MenuItem {
  id            String   @id @default(uuid())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId  String
  name          String
  description   String?
  priceCents    Int
  imageUrl      String?
  isAvailable   Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orderItems    OrderItem[]
}

model Order {
  id              String       @id @default(uuid())
  user            User         @relation(fields: [userId], references: [id])
  userId          String
  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id])
  restaurantId    String
  deliveryAddress String
  totalAmountCents Int
  status          OrderStatus  @default(pending)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  orderItems      OrderItem[]
  payments        Payment[]
  delivery        Delivery?
}

model OrderItem {
  id         String  @id @default(uuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  quantity   Int
  unitPriceCents Int
  createdAt  DateTime @default(now())
}

model Payment {
  id             String        @id @default(uuid())
  order          Order         @relation(fields: [orderId], references: [id])
  orderId        String
  method         PaymentMethod
  status         PaymentStatus @default(initiated)
  transactionId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Delivery {
  id          String         @id @default(uuid())
  order       Order          @relation(fields: [orderId], references: [id])
  orderId     String         @unique
  driver      User?          @relation("DriverDeliveries", fields: [driverId], references: [id])
  driverId    String?
  status      DeliveryStatus @default(waiting)
  pickupTime  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
